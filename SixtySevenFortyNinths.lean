/-! ## unit T469_slice_symmetrization_orbit_rows -/
section
open Finset

/-- Relabel a finset by a permutation of the ground set. -/
def nadiaRelabel {α : Type*} [DecidableEq α] (e : Equiv.Perm α) (S : Finset α) : Finset α := S.map e.toEmbedding

theorem nadia_relabel_mul {α : Type*} [DecidableEq α] (e f : Equiv.Perm α) (S : Finset α) :
    nadiaRelabel e (nadiaRelabel f S) = nadiaRelabel (e * f) S := by
  ext x
  simp only [nadiaRelabel, Finset.map_map, Finset.mem_map, Equiv.coe_toEmbedding]
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a, ha, by simp [Equiv.Perm.mul_apply]⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a, ha, by simp [Equiv.Perm.mul_apply]⟩

/-- Orbit sum of a set function along a finite group of relabelings. -/
def nadiaOrbitSum {G α β : Type*} [Group G] [Fintype G] [DecidableEq α] [AddCommMonoid β]
    (ρ : G →* Equiv.Perm α) (D : Finset α → β) (S : Finset α) : β :=
  ∑ g : G, D (nadiaRelabel (ρ g) S)

/-- T469 (Nadia): orbit sums are relabeling-invariant. -/
theorem nadia_orbitSum_relabel {G α β : Type*} [Group G] [Fintype G] [DecidableEq α] [AddCommMonoid β]
    (ρ : G →* Equiv.Perm α) (D : Finset α → β) (h : G) (S : Finset α) :
    nadiaOrbitSum ρ D (nadiaRelabel (ρ h) S) = nadiaOrbitSum ρ D S := by
  unfold nadiaOrbitSum
  simp_rw [nadia_relabel_mul, ← map_mul]
  exact Fintype.sum_equiv (Equiv.mulRight h) _ _ (fun g => rfl)

/-- T469 (Nadia): an inequality row valid at every relabeling sums to its orbit row. -/
theorem nadia_orbit_row_le {G α ι : Type*} [Group G] [Fintype G] [DecidableEq α] [Fintype ι]
    {β : Type*} [Field β] [LinearOrder β] [IsStrictOrderedRing β]
    (ρ : G →* Equiv.Perm α) (D : Finset α → β) (c : ι → β) (S : ι → Finset α) (b : β)
    (h : ∀ g : G, ∑ i, c i * D (nadiaRelabel (ρ g) (S i)) ≤ b) :
    ∑ i, c i * nadiaOrbitSum ρ D (S i) ≤ (Fintype.card G : β) * b := by
  unfold nadiaOrbitSum
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  calc ∑ g : G, ∑ i, c i * D (nadiaRelabel (ρ g) (S i)) ≤ ∑ _g : G, b := Finset.sum_le_sum (fun g _ => h g)
    _ = (Fintype.card G : β) * b := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

/-- T469 (Nadia): an equality row valid at every relabeling sums to its orbit row. -/
theorem nadia_orbit_row_eq {G α ι : Type*} [Group G] [Fintype G] [DecidableEq α] [Fintype ι]
    {β : Type*} [Field β] (ρ : G →* Equiv.Perm α) (D : Finset α → β) (c : ι → β) (S : ι → Finset α) (b : β)
    (h : ∀ g : G, ∑ i, c i * D (nadiaRelabel (ρ g) (S i)) = b) :
    ∑ i, c i * nadiaOrbitSum ρ D (S i) = (Fintype.card G : β) * b := by
  unfold nadiaOrbitSum
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  calc ∑ g : G, ∑ i, c i * D (nadiaRelabel (ρ g) (S i)) = ∑ _g : G, b := Finset.sum_congr rfl (fun g _ => h g)
    _ = (Fintype.card G : β) * b := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

/-- The slice action: a permutation of Fin L acts on both copies (A and C) of Fin 2 × Fin L. -/
def nadiaSliceAct (L : ℕ) : Equiv.Perm (Fin L) →* Equiv.Perm (Fin 2 × Fin L) where
  toFun σ := Equiv.prodCongr (Equiv.refl (Fin 2)) σ
  map_one' := by ext x <;> simp
  map_mul' σ τ := by ext x <;> simp [Equiv.Perm.mul_apply]

/-- The same action on Fin (2 * L), with A = 0..L-1 and C = L..2L-1 (finProdFinEquiv). -/
def nadiaSliceActFin (L : ℕ) : Equiv.Perm (Fin L) →* Equiv.Perm (Fin (2 * L)) where
  toFun σ := finProdFinEquiv.permCongr (nadiaSliceAct L σ)
  map_one' := by ext x; simp [Equiv.permCongr_apply]; exact Nat.mod_add_div _ _
  map_mul' σ τ := by ext x; simp [Equiv.permCongr_apply, Equiv.Perm.mul_apply]
end

/-! ## unit T475_L7_slice_orbit_set_functions -/
section
-- T475 step (2a), Hugo: the L = 7 slice set functions on Fin 2 × Fin 7 ((0, y) = A_y, (1, y) = C_y), their S_7 orbit sums,
-- and the orbit forms of submodularity, monotonicity and type invariance (Nadia's nadia_orbitSum_relabel).
open Finset

/-- T475 (Hugo): the slice family at L = 7: (0, y) ↦ col M_(s y), (1, y) ↦ col M'_(s y). -/
def hugoL7W {F : Type*} [Field F] {N a b : ℕ} (M : Fin N → Matrix (Fin N) (Fin a) F)
    (M' : Fin N → Matrix (Fin N) (Fin b) F) (s : Fin 7 → Fin N) (i : Fin 2 × Fin 7) :
    Submodule F (Fin N → F) :=
  if i.1 = 0 then LinearMap.range (M (s i.2)).mulVecLin else LinearMap.range (M' (s i.2)).mulVecLin

/-- T475 (Hugo): span rank of a set of slice spaces, in ℚ. -/
noncomputable def hugoL7D {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (S : Finset (Fin 2 × Fin 7)) : ℚ :=
  (Module.finrank F ↥(⨆ i ∈ S, W i) : ℚ)

/-- T475 (Hugo): the S_7 orbit sum of the span rank. -/
noncomputable def hugoL7O {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (S : Finset (Fin 2 × Fin 7)) : ℚ :=
  nadiaOrbitSum (nadiaSliceAct 7) (hugoL7D W) S

theorem hugo_L7_D_submod {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (S U V T : Finset (Fin 2 × Fin 7)) (hSU : S ⊆ U) (hSV : S ⊆ V) (hT : T = U ∪ V) :
    hugoL7D W T + hugoL7D W S ≤ hugoL7D W U + hugoL7D W V := by
  have h := lena_iSup_finset_submod W S U V T hSU hSV hT
  unfold hugoL7D
  exact_mod_cast h

theorem hugo_L7_D_mono {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (S T : Finset (Fin 2 × Fin 7)) (h : S ⊆ T) : hugoL7D W S ≤ hugoL7D W T := by
  have h' := lena_iSup_finset_mono W S T h
  unfold hugoL7D
  exact_mod_cast h'

theorem hugo_L7_O_submod {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (S U V T : Finset (Fin 2 × Fin 7)) (hSU : S ⊆ U) (hSV : S ⊆ V) (hT : T = U ∪ V) :
    hugoL7O W T + hugoL7O W S ≤ hugoL7O W U + hugoL7O W V := by
  unfold hugoL7O nadiaOrbitSum
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro σ _
  apply hugo_L7_D_submod
  · exact Finset.map_subset_map.2 hSU
  · exact Finset.map_subset_map.2 hSV
  · rw [hT]; exact Finset.map_union _ _

theorem hugo_L7_O_mono {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (S T : Finset (Fin 2 × Fin 7)) (h : S ⊆ T) : hugoL7O W S ≤ hugoL7O W T := by
  unfold hugoL7O nadiaOrbitSum
  apply Finset.sum_le_sum
  intro σ _
  exact hugo_L7_D_mono W _ _ (Finset.map_subset_map.2 h)

/-- T475 (Hugo): orbit sums depend on the orbit type only (from nadia_orbitSum_relabel). -/
theorem hugo_L7_O_type {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (τ : Equiv.Perm (Fin 7)) (S T : Finset (Fin 2 × Fin 7)) (h : nadiaRelabel (nadiaSliceAct 7 τ) S = T) :
    hugoL7O W T = hugoL7O W S := by
  rw [← h]
  exact nadia_orbitSum_relabel (nadiaSliceAct 7) (hugoL7D W) τ S

-- decide test: the type-(2,1,0) canonical set A0 + A1 + C2 relabels to A0 + C1 + A2 by the swap (1 2)
example : nadiaRelabel (nadiaSliceAct 7 (Equiv.swap 1 2)) ({(0, 0), (0, 1), (1, 2)} : Finset (Fin 2 × Fin 7))
    = {(0, 0), (1, 1), (0, 2)} := by decide

theorem hugo_L7_card_perm : (Fintype.card (Equiv.Perm (Fin 7)) : ℚ) = 5040 := by
  rw [Fintype.card_perm, Fintype.card_fin]; norm_num [Nat.factorial]
end

