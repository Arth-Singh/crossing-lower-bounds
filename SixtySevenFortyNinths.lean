    apply Finset.sum_le_sum
    intro σ _
    rw [lena_L7_relabel2, lena_L7_D2, lena_L7_W0, lena_L7_W1, milo_slice_col_YQ_finrank X Y P Q hd]

/-- Rows (3)-(6): caps and Sylvester, summed over S_7 (y = σ 0, u = σ 1), then moved to canonical sets. -/
theorem lena_L7_row3456 {F : Type*} [Field F] {N r k : ℕ} (X Y : Fin N → Matrix (Fin N) (Fin r) F)
    (P Q : Fin N → Matrix (Fin N) (Fin k) F) (ho : ∀ y u, y ≠ u → X y * (Y u)ᵀ + P u * (Q y)ᵀ = 0)
    (s : Fin 7 → Fin N) (hs : ∀ y u : Fin 7, y ≠ u → s y ≠ s u) :
    (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) + hugoL7O (hugoL7W X P s) {(0, 0), (1, 1)} ≤
        hugoL7O (hugoL7W X P s) {(0, 0)} + hugoL7O (hugoL7W X P s) {(1, 0)} ∧
      (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) + hugoL7O (hugoL7W Y Q s) {(0, 0), (1, 1)} ≤
        hugoL7O (hugoL7W Y Q s) {(0, 0)} + hugoL7O (hugoL7W Y Q s) {(1, 0)} ∧
      hugoL7O (hugoL7W X P s) {(0, 0)} + hugoL7O (hugoL7W Y Q s) {(0, 0)} ≤
        (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) + 5040 * (r : ℚ) ∧
      hugoL7O (hugoL7W X P s) {(1, 0)} + hugoL7O (hugoL7W Y Q s) {(1, 0)} ≤
        (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) + 5040 * (k : ℚ) := by
  have h01 : ∀ σ : Equiv.Perm (Fin 7), s (σ 0) ≠ s (σ 1) := fun σ => hs _ _ (fun h => by
    have := σ.injective h; exact absurd this (by decide))
  -- type moves: swap 0 1 relabels (1,0) to (1,1), (0,1) to (0,0), {(0,1),(1,0)} to {(0,0),(1,1)}
  have tC : ∀ W : Fin 2 × Fin 7 → Submodule F (Fin N → F), hugoL7O W {(1, 1)} = hugoL7O W {(1, 0)} := fun W =>
    hugo_L7_O_type W (Equiv.swap 0 1) _ _ (by rw [lena_L7_relabel1]; simp)
  have tA : ∀ W : Fin 2 × Fin 7 → Submodule F (Fin N → F), hugoL7O W {(0, 1)} = hugoL7O W {(0, 0)} := fun W =>
    hugo_L7_O_type W (Equiv.swap 0 1) _ _ (by rw [lena_L7_relabel1]; simp)
  have tP : ∀ W : Fin 2 × Fin 7 → Submodule F (Fin N → F),
      hugoL7O W {(0, 1), (1, 0)} = hugoL7O W {(0, 0), (1, 1)} := fun W =>
    (hugo_L7_O_type W (Equiv.swap 0 1) _ _ (by rw [lena_L7_relabel2]; simp)).symm
  -- raw orbit rows
  have r3 : (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) +
      hugoL7O (hugoL7W X P s) {(0, 0), (1, 1)} ≤ hugoL7O (hugoL7W X P s) {(0, 0)} + hugoL7O (hugoL7W X P s) {(1, 1)} := by
    unfold hugoL7O nadiaOrbitSum
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro σ _
    rw [lena_L7_relabel2, lena_L7_relabel1, lena_L7_relabel1, lena_L7_D2, lena_L7_D1, lena_L7_D1, lena_L7_W0,
      lena_L7_W1]
    have := hugo_slice_cap_left X Y P Q ho (s (σ 0)) (s (σ 1)) (h01 σ)
    exact_mod_cast this
  have r4 : (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) +
      hugoL7O (hugoL7W Y Q s) {(0, 1), (1, 0)} ≤ hugoL7O (hugoL7W Y Q s) {(0, 1)} + hugoL7O (hugoL7W Y Q s) {(1, 0)} := by
    unfold hugoL7O nadiaOrbitSum
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro σ _
    rw [lena_L7_relabel2, lena_L7_relabel1, lena_L7_relabel1, lena_L7_D2, lena_L7_D1, lena_L7_D1, lena_L7_W0,
      lena_L7_W1]
    have := hugo_slice_cap_right X Y P Q ho (s (σ 0)) (s (σ 1)) (h01 σ)
    exact_mod_cast this
  have r5 : hugoL7O (hugoL7W X P s) {(0, 0)} + hugoL7O (hugoL7W Y Q s) {(0, 1)} ≤
      (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) + 5040 * (r : ℚ) := by
    unfold hugoL7O nadiaOrbitSum
    rw [← hugo_L7_card_perm, ← nsmul_eq_mul, ← Finset.card_univ, ← Finset.sum_const, ← Finset.sum_add_distrib,
      ← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro σ _
    rw [lena_L7_relabel1, lena_L7_relabel1, lena_L7_D1, lena_L7_D1, lena_L7_W0, lena_L7_W0]
    have := nadia_rank_add_rank_le_rank_mul (X (s (σ 0))) (Y (s (σ 1)))ᵀ
    rw [Fintype.card_fin, Matrix.rank_transpose] at this
    have e1 : Module.finrank F ↥(LinearMap.range (X (s (σ 0))).mulVecLin) = (X (s (σ 0))).rank := rfl
    have e2 : Module.finrank F ↥(LinearMap.range (Y (s (σ 1))).mulVecLin) = (Y (s (σ 1))).rank := rfl
    rw [e1, e2]
    exact_mod_cast this
  have r6 : hugoL7O (hugoL7W X P s) {(1, 1)} + hugoL7O (hugoL7W Y Q s) {(1, 0)} ≤
      (∑ σ : Equiv.Perm (Fin 7), ((X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank : ℚ)) + 5040 * (k : ℚ) := by
    unfold hugoL7O nadiaOrbitSum
    rw [← hugo_L7_card_perm, ← nsmul_eq_mul, ← Finset.card_univ, ← Finset.sum_const, ← Finset.sum_add_distrib,
      ← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro σ _
    rw [lena_L7_relabel1, lena_L7_relabel1, lena_L7_D1, lena_L7_D1, lena_L7_W1, lena_L7_W1]
    have := nadia_rank_add_rank_le_rank_mul (P (s (σ 1))) (Q (s (σ 0)))ᵀ
    rw [Fintype.card_fin, Matrix.rank_transpose] at this
    have e : (X (s (σ 0)) * (Y (s (σ 1)))ᵀ).rank = (P (s (σ 1)) * (Q (s (σ 0)))ᵀ).rank := by
      rw [eq_neg_of_add_eq_zero_left (ho _ _ (h01 σ)), lena_rank_neg]
    have e1 : Module.finrank F ↥(LinearMap.range (P (s (σ 1))).mulVecLin) = (P (s (σ 1))).rank := rfl
    have e2 : Module.finrank F ↥(LinearMap.range (Q (s (σ 0))).mulVecLin) = (Q (s (σ 0))).rank := rfl
    rw [e1, e2, e]
    exact_mod_cast this
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← tC (hugoL7W X P s)]; exact r3
  · rw [← tP (hugoL7W Y Q s), ← tA (hugoL7W Y Q s)]; exact r4
  · rw [← tA (hugoL7W Y Q s)]; exact r5
  · rw [← tC (hugoL7W X P s)]; exact r6
end

