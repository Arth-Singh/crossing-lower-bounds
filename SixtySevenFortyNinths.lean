/-- **T475 explicit orbit rows (Lena, for Hugo's 67n/49 unit)**, rows (1) and (2): 5040 N ≤ Of {A0, C0}, Og {A0, C0}. -/
theorem lena_L7_row12 {F : Type*} [Field F] {N r k : ℕ} (X Y : Fin N → Matrix (Fin N) (Fin r) F)
    (P Q : Fin N → Matrix (Fin N) (Fin k) F) (hd : ∀ y, X y * (Y y)ᵀ + P y * (Q y)ᵀ = 1) (s : Fin 7 → Fin N) :
    5040 * (N : ℚ) ≤ hugoL7O (hugoL7W X P s) {(0, 0), (1, 0)} ∧
      5040 * (N : ℚ) ≤ hugoL7O (hugoL7W Y Q s) {(0, 0), (1, 0)} := by
  constructor
  · unfold hugoL7O nadiaOrbitSum
    rw [← hugo_L7_card_perm, ← nsmul_eq_mul, ← Finset.card_univ, ← Finset.sum_const]
    apply Finset.sum_le_sum
    intro σ _
    rw [lena_L7_relabel2, lena_L7_D2, lena_L7_W0, lena_L7_W1, milo_slice_col_XP_finrank X Y P Q hd]
  · unfold hugoL7O nadiaOrbitSum
