    nadiaRelabel (nadiaSliceAct 7 σ) {(i, a), (j, b)} = {(i, σ a), (j, σ b)} := by
  simp [nadiaRelabel, nadiaSliceAct]

theorem lena_L7_D1 {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F)) (x : Fin 2 × Fin 7) :
    hugoL7D W {x} = (Module.finrank F ↥(W x) : ℚ) := by
  unfold hugoL7D; rw [lena_iSup_finset_singleton]

theorem lena_L7_D2 {F : Type*} [Field F] {N : ℕ} (W : Fin 2 × Fin 7 → Submodule F (Fin N → F))
    (x y : Fin 2 × Fin 7) : hugoL7D W {x, y} = (Module.finrank F ↥(W x ⊔ W y) : ℚ) := by
  unfold hugoL7D; rw [lena_iSup_finset_pair]

theorem lena_L7_W0 {F : Type*} [Field F] {N a b : ℕ} (M : Fin N → Matrix (Fin N) (Fin a) F)
    (M' : Fin N → Matrix (Fin N) (Fin b) F) (s : Fin 7 → Fin N) (y : Fin 7) :
    hugoL7W M M' s (0, y) = LinearMap.range (M (s y)).mulVecLin := by simp [hugoL7W]

theorem lena_L7_W1 {F : Type*} [Field F] {N a b : ℕ} (M : Fin N → Matrix (Fin N) (Fin a) F)
    (M' : Fin N → Matrix (Fin N) (Fin b) F) (s : Fin 7 → Fin N) (y : Fin 7) :
