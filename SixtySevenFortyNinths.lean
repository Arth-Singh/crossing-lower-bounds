    (h74 : (-1 : ℚ) * hugoL7V (hugoL7W X P s) (hugoL7W Y Q s) M (5040 * (r : ℚ)) (5040 * (k : ℚ)) 128 + (-1 : ℚ) * hugoL7V (hugoL7W X P s) (hugoL7W Y Q s) M (5040 * (r : ℚ)) (5040 * (k : ℚ)) 156 + (1 : ℚ) * hugoL7V (hugoL7W X P s) (hugoL7W Y Q s) M (5040 * (r : ℚ)) (5040 * (k : ℚ)) 163 + (1 : ℚ) * hugoL7V (hugoL7W X P s) (hugoL7W Y Q s) M (5040 * (r : ℚ)) (5040 * (k : ℚ)) 240 ≤ 0)
